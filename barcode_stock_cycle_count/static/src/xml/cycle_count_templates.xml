<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="barcode_stock_cycle_count.CycleCountListScreen">
        <div class="ilx-kw-screen ilx-kw-cycle-count-list ilx-emp-v2-screen">
            <header class="ilx-kw-header ilx-kw-header--elevated ilx-emp-v2-header">
                <button
                    type="button"
                    class="ilx-kw-icon-btn ilx-emp-v2-back-btn"
                    t-on-click="goBack"
                ><i class="fa fa-arrow-left" /></button>
                <div class="ilx-kw-header-left"><h1
                        class="ilx-kw-header-title ilx-emp-v2-header-title"
                    >Cycle Count</h1></div>
                <div class="header-spacer" />
            </header>
            <main class="ilx-kw-main ilx-emp-v2-main">
                <section class="ilx-kw-search-section">
                    <div class="ilx-kw-search-bar"><i
                            class="fa fa-search ilx-kw-search-icon"
                        /><input
                            name="search"
                            type="text"
                            class="ilx-kw-search-input"
                            placeholder="Scan or search cycle counts..."
                            t-model="state.search"
                        /></div>
                    <div class="ilx-kw-filter-tools" t-on-click.stop="() => {}">
                        <div class="ilx-kw-filter-toolbar">
                            <button
                                type="button"
                                class="ilx-kw-tool-btn"
                                t-att-class="{active: state.openMenu === 'filters', 'has-value': state.activeFilters.length}"
                                t-on-click="() => this.toggleMenu('filters')"
                            ><i class="fa fa-filter" /><span>Filters</span><span
                                    t-if="state.activeFilters.length"
                                    class="ilx-kw-tool-count"
                                    t-esc="state.activeFilters.length"
                                /><i class="fa fa-caret-down" /></button>
                            <button
                                type="button"
                                class="ilx-kw-tool-btn"
                                t-att-class="{active: state.openMenu === 'group', 'has-value': state.groupByLevels.length}"
                                t-on-click="() => this.toggleMenu('group')"
                            ><i class="fa fa-layer-group" /><span>Group by</span><i
                                    class="fa fa-caret-down"
                                /></button>
                            <div class="ilx-kw-tool-spacer" />
                            <button
                                type="button"
                                class="ilx-kw-tool-btn ilx-kw-star-btn"
                                t-att-class="{active: isCurrentFilterDefault}"
                                t-on-click="toggleDefaultFilter"
                                title="Save default filter"
                            ><i
                                    t-att-class="isCurrentFilterDefault ? 'fa fa-star' : 'fa fa-star-o'"
                                /></button>
                            <button
                                type="button"
                                class="ilx-kw-tool-btn"
                                t-if="state.search || state.activeFilters.length"
                                t-on-click="clearFilters"
                            ><i class="fa fa-times" /><span>Clear</span></button>
                            <div
                                class="ilx-kw-menu"
                                t-if="state.openMenu === 'filters'"
                            >
                                <div class="ilx-kw-menu-section"><div
                                        class="ilx-kw-menu-title"
                                    >State</div>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-att-class="{selected: state.filterValues.state === 'draft'}"
                                        t-on-click="() => this.setFilterValue('state', 'draft')"
                                    ><i class="fa fa-circle-o" /> Planned</button>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-att-class="{selected: state.filterValues.state === 'open'}"
                                        t-on-click="() => this.setFilterValue('state', 'open')"
                                    ><i class="fa fa-circle-o" /> Execution</button>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-on-click="() => this.setFilterValue('state', 'all')"
                                    ><i class="fa fa-circle-o" /> All</button>
                                </div>
                                <div class="ilx-kw-menu-section"><div
                                        class="ilx-kw-menu-title"
                                    >Assignment</div>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-on-click="() => this.setAssignment('mine')"
                                    ><i class="fa fa-user" /> Mine</button>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-on-click="() => this.setAssignment('unassigned')"
                                    ><i class="fa fa-user-o" /> Unassigned</button>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-on-click="() => this.setAssignment('all')"
                                    ><i class="fa fa-users" /> All</button>
                                </div>
                                <div class="ilx-kw-menu-section"><div
                                        class="ilx-kw-menu-title"
                                    >Deadline</div>
                                    <t
                                        t-foreach="[['overdue', 'Overdue'], ['today', 'Today'], ['week', 'This week']]"
                                        t-as="option"
                                        t-key="option[0]"
                                    ><button
                                            type="button"
                                            class="ilx-kw-menu-option"
                                            t-on-click="() => this.setFilterValue('deadline', option[0])"
                                        ><i class="fa fa-calendar" /> <t
                                                t-esc="option[1]"
                                            /></button></t>
                                    <div class="ilx-kw-menu-custom-date"><input
                                            type="date"
                                            class="ilx-kw-filter-date-input"
                                            t-on-change="(ev) => this.setCustomDate(ev.target.value)"
                                        /></div>
                                    <button
                                        type="button"
                                        class="ilx-kw-menu-option"
                                        t-on-click="() => this.setFilterValue('deadline', null)"
                                    ><i class="fa fa-circle-o" /> All</button>
                                </div>
                            </div>
                            <div
                                class="ilx-kw-menu"
                                t-if="state.openMenu === 'group'"
                            ><div class="ilx-kw-menu-section"><div
                                        class="ilx-kw-menu-title"
                                    >Group by</div><t
                                        t-foreach="groupOrder"
                                        t-as="group"
                                        t-key="group"
                                    ><button
                                            type="button"
                                            class="ilx-kw-menu-option"
                                            t-att-class="{selected: state.groupByLevels.includes(group)}"
                                            t-on-click="() => this.toggleGroupLevel(group)"
                                        ><i
                                                class="fa fa-check-square-o"
                                                t-if="state.groupByLevels.includes(group)"
                                            /><i class="fa fa-square-o" t-else="" /> <t
                                                t-esc="groupLabels[group]"
                                            /></button></t></div></div>
                        </div>
                        <div
                            class="ilx-kw-facets"
                            t-if="state.activeFilters.length || state.groupByLevels.length"
                        ><t
                                t-foreach="state.activeFilters"
                                t-as="filter"
                                t-key="filter"
                            ><span class="ilx-kw-facet"><span><t
                                            t-esc="filterLabels[filter]"
                                        />: <t
                                            t-esc="state.filterValues[filter]"
                                        /></span><button
                                        type="button"
                                        class="ilx-kw-facet-remove"
                                        t-on-click="() => this.removeFilter(filter)"
                                    ><i class="fa fa-times" /></button></span></t><t
                                t-foreach="state.groupByLevels"
                                t-as="group"
                                t-key="group"
                            ><span class="ilx-kw-facet"><span><i
                                            class="fa fa-layer-group"
                                        /> <t
                                            t-esc="groupLabels[group]"
                                        /></span><button
                                        type="button"
                                        class="ilx-kw-facet-remove"
                                        t-on-click="() => this.removeGroup(group)"
                                    ><i class="fa fa-times" /></button></span></t></div>
                    </div>
                </section>
                <section class="ilx-queue-shell">

                    <div class="ilx-queue-filters"><span
                            class="ilx-filter-chip"
                            t-if="state.groupByLevels.length"
                        ><i class="fa fa-layer-group" /> Grouped</span></div>
                    <div class="ilx-queue-groups">
                        <div
                            t-if="state.loading"
                            class="ilx-queue-empty-state ilx-queue-loading"
                        ><div class="ilx-empty-text">Loading cycle counts...</div></div>
                        <div
                            t-elif="state.error"
                            class="ilx-queue-empty-state ilx-queue-error"
                        ><div
                                class="ilx-empty-text"
                            >Unable to load cycle counts.</div><div
                                class="ilx-empty-text-sm"
                            >Try again from the list.</div></div>
                        <div
                            t-elif="!state.counts.length"
                            class="ilx-queue-empty-state"
                        ><div class="ilx-empty-text">No cycle counts found.</div><div
                                class="ilx-empty-text-sm"
                            >There are no planned counts in this queue.</div></div>
                        <div
                            t-elif="!filteredCounts.length"
                            class="ilx-queue-empty-state"
                        ><div
                                class="ilx-empty-text"
                            >No matching cycle counts.</div><button
                                type="button"
                                class="btn btn-link"
                                t-on-click="clearFilters"
                            >Clear all</button></div>
                        <t t-else="">
                            <t
                                t-foreach="sortedGroupKeys(state.groupedCounts)"
                                t-as="groupKey"
                                t-key="groupKey"
                            ><div class="ilx-queue-group"><div
                                        t-if="groupKey !== 'all'"
                                        class="ilx-queue-group__header"
                                        t-on-click="() => this.toggleGroup('root-' + groupKey)"
                                    ><div class="ilx-queue-group__copy"><span
                                                class="ilx-queue-group__title"
                                                t-esc="groupKey"
                                            /><span
                                                class="ilx-queue-group__summary"
                                                t-esc="countGroupEntries(state.groupedCounts[groupKey])"
                                            /></div><i
                                            class="ilx-queue-group__chevron fa"
                                            t-att-class="state.collapsedGroups['root-' + groupKey] ? 'fa-chevron-down' : 'fa-chevron-up'"
                                        /></div><div
                                        t-if="!state.collapsedGroups['root-' + groupKey]"
                                        class="ilx-queue-group__body"
                                    ><t
                                            t-if="Array.isArray(state.groupedCounts[groupKey])"
                                        ><t
                                                t-foreach="state.groupedCounts[groupKey]"
                                                t-as="count"
                                                t-key="count.id"
                                            ><article
                                                    class="ilx-queue-card ilx-emp-v2-card"
                                                    role="button"
                                                    tabindex="0"
                                                    t-on-click="() => this.selectCount(count)"
                                                    t-on-keydown="(ev) => this.onCountCardKeydown(ev, count)"
                                                    t-on-keyup="(ev) => this.onCountCardKeyup(ev, count)"
                                                >
                                                    <div class="ilx-queue-card__top">
                                                        <h3
                                                            class="ilx-queue-card__code ilx-cycle-count-card__name"
                                                            t-esc="count.name"
                                                        />
                                                        <div class="ilx-queue-card__status">
                                                            <span
                                                                t-att-class="getStateBadgeClass(count)"
                                                                t-esc="getStateLabel(count)"
                                                            />
                                                            <i
                                                                class="ilx-queue-card__arrow fa fa-chevron-right"
                                                                aria-hidden="true"
                                                            />
                                                        </div>
                                                    </div>
                                                    <div class="ilx-cycle-count-card__location">
                                                        <i class="fa fa-map-marker" aria-hidden="true" />
                                                        <span
                                                            class="ilx-cycle-count-card__location-name"
                                                            t-esc="getCountLocation(count)"
                                                        />
                                                    </div>
                                                    <div class="ilx-queue-card__meta-row">
                                                        <span class="ilx-queue-meta-pill ilx-cycle-count-card__meta ilx-cycle-count-card__assignee">
                                                            <i class="fa fa-user" aria-hidden="true" />
                                                            <span class="visually-hidden">Assignee: </span>
                                                            <span t-esc="getCountAssignee(count)" />
                                                        </span>
                                                        <span
                                                            class="ilx-queue-meta-pill ilx-cycle-count-card__meta ilx-cycle-count-card__deadline"
                                                            t-att-class="getDeadlineMetaClass(count)"
                                                        >
                                                            <i class="fa fa-calendar" aria-hidden="true" />
                                                            <span class="visually-hidden">Deadline: </span>
                                                            <t t-esc="getDeadlineLabel(count)" />
                                                        </span>
                                                    </div>
                                                </article></t></t><t
                                            t-else=""
                                        ><t
                                                t-foreach="sortedGroupKeys(state.groupedCounts[groupKey])"
                                                t-as="childKey"
                                                t-key="childKey"
                                            ><div class="ilx-queue-group"><div
                                                        class="ilx-queue-group__header"
                                                        t-on-click="() => this.toggleGroup('root-' + groupKey + '/child-' + childKey)"
                                                    ><div
                                                            class="ilx-queue-group__copy"
                                                        ><span
                                                                class="ilx-queue-group__title"
                                                                t-esc="childKey"
                                                            /><span
                                                                class="ilx-queue-group__summary"
                                                                t-esc="countGroupEntries(state.groupedCounts[groupKey][childKey])"
                                                            /></div><i
                                                            class="ilx-queue-group__chevron fa fa-chevron-down"
                                                        /></div><div
                                                        class="ilx-queue-group__body"
                                                    ><t
                                                            t-foreach="state.groupedCounts[groupKey][childKey]"
                                                            t-as="count"
                                                            t-key="count.id"
                                                            ><article
                                                                    class="ilx-queue-card ilx-emp-v2-card"
                                                                    role="button"
                                                                    tabindex="0"
                                                                    t-on-click="() => this.selectCount(count)"
                                                                    t-on-keydown="(ev) => this.onCountCardKeydown(ev, count)"
                                                                    t-on-keyup="(ev) => this.onCountCardKeyup(ev, count)"
                                                            >
                                                                <div class="ilx-queue-card__top">
                                                                    <h3
                                                                        class="ilx-queue-card__code ilx-cycle-count-card__name"
                                                                        t-esc="count.name"
                                                                    />
                                                                    <div class="ilx-queue-card__status">
                                                                        <span
                                                                            t-att-class="getStateBadgeClass(count)"
                                                                            t-esc="getStateLabel(count)"
                                                                        />
                                                                        <i
                                                                            class="ilx-queue-card__arrow fa fa-chevron-right"
                                                                            aria-hidden="true"
                                                                        />
                                                                    </div>
                                                                </div>
                                                                <div class="ilx-cycle-count-card__location">
                                                                    <i class="fa fa-map-marker" aria-hidden="true" />
                                                                    <span
                                                                        class="ilx-cycle-count-card__location-name"
                                                                        t-esc="getCountLocation(count)"
                                                                    />
                                                                </div>
                                                                <div class="ilx-queue-card__meta-row">
                                                                    <span class="ilx-queue-meta-pill ilx-cycle-count-card__meta ilx-cycle-count-card__assignee">
                                                                        <i class="fa fa-user" aria-hidden="true" />
                                                                        <span class="visually-hidden">Assignee: </span>
                                                                        <span t-esc="getCountAssignee(count)" />
                                                                    </span>
                                                                    <span
                                                                        class="ilx-queue-meta-pill ilx-cycle-count-card__meta ilx-cycle-count-card__deadline"
                                                                        t-att-class="getDeadlineMetaClass(count)"
                                                                    >
                                                                        <i class="fa fa-calendar" aria-hidden="true" />
                                                                        <span class="visually-hidden">Deadline: </span>
                                                                        <t t-esc="getDeadlineLabel(count)" />
                                                                    </span>
                                                                </div>
                                                            </article></t></div></div></t></t></div></div></t>
                        </t>
                    </div>
                </section>
            </main>
        </div>
    </t>
    <t t-name="barcode_stock_cycle_count.CycleCountLocationScreen">
        <div class="ilx-emp-v2-screen"><header class="ilx-emp-v2-header"><button
                    class="ilx-emp-v2-back-btn"
                    t-on-click="goBack"
                ><i class="fa fa-arrow-left" /></button><h1
                    class="ilx-emp-v2-header-title"
                >Confirm Cycle Count</h1></header><main class="ilx-emp-v2-main"><div
                    class="ilx-emp-v2-card"
                ><div class="ilx-emp-v2-info"><span class="ilx-emp-v2-name"><t
                                t-esc="state.count?.name"
                            /></span><span class="ilx-emp-v2-role">Expected location: <t
                                t-esc="state.count?.location_name"
                            /></span></div></div>
                <section
                    t-if="state.startError"
                    class="ilx-cycle-count-start-alert"
                    t-att-class="'ilx-cycle-count-start-alert--' + state.startError.type"
                    role="alert"
                    aria-live="assertive"
                ><span class="ilx-cycle-count-start-alert__icon" aria-hidden="true"><i
                            t-att-class="state.startError.type === 'blocked' ? 'fa fa-lock' : 'fa fa-exclamation-triangle'"
                        /></span><div class="ilx-cycle-count-start-alert__content"><span
                            class="ilx-cycle-count-start-alert__eyebrow"
                        >START BLOCKED</span><h2
                            class="ilx-cycle-count-start-alert__title"
                            t-esc="state.startError.title"
                        /><p
                            class="ilx-cycle-count-start-alert__message"
                            t-esc="state.startError.message"
                        /><div
                            t-if="state.startError.blockers"
                            class="ilx-cycle-count-start-alert__facts"
                        ><div><span>Location</span><strong
                                    t-esc="state.startError.location"
                                /></div><div><span>Blocking adjustment</span><strong
                                    t-esc="state.startError.blockers"
                                /></div></div><p
                            t-if="state.startError.action"
                            class="ilx-cycle-count-start-alert__action"
                            t-esc="state.startError.action"
                        /><details t-if="state.startError.detail"><summary
                                class="ilx-cycle-count-start-alert__details-toggle"
                            >Technical message</summary><p
                                class="ilx-cycle-count-start-alert__detail"
                                t-esc="state.startError.detail"
                            /></details></div></section><button
                    class="ilx-emp-v2-confirm-btn"
                    t-if="!state.confirmed"
                    t-on-click="confirmStart"
                    t-att-disabled="state.starting"
                    t-att-aria-busy="state.starting"
                ><t t-if="state.starting"><i class="fa fa-spinner fa-spin" /> Starting...</t><t
                        t-elif="state.startError"
                    >Try again</t><t t-else="">Confirm and start</t></button><div t-else="" class="ilx-emp-v2-card"><div
                        class="ilx-emp-v2-info"
                    ><span
                            class="ilx-emp-v2-name"
                        >Scan the expected location</span><span
                            class="ilx-emp-v2-role"
                        ><t
                                t-esc="state.count?.location_name"
                            /></span></div></div><button
                    class="btn btn-link"
                    t-if="state.confirmed"
                    t-on-click="skipLocation"
                >Continue without scan</button></main></div>
    </t>
    <t t-name="barcode_stock_cycle_count.CycleCountCountScreen">
        <div class="ilx-emp-v2-screen ilx-cycle-count-count">
            <header class="ilx-emp-v2-header ilx-count-header">
                <button
                    type="button"
                    class="ilx-emp-v2-back-btn"
                    aria-label="Go back"
                    t-on-click="goBack"
                    t-att-disabled="state.saving"
                ><i class="fa fa-arrow-left" /></button>
                <div class="ilx-count-header__copy">
                    <div class="ilx-count-header__title-row">
                        <h1 class="ilx-emp-v2-header-title">Cycle Count</h1>
                    </div>
                    <span
                        t-if="props.params.cycleCount?.name"
                        class="ilx-count-header__name"
                        t-esc="props.params.cycleCount.name"
                    />
                    <span class="ilx-count-header__location">
                        <i class="fa fa-map-marker" aria-hidden="true" />
                        <t
                            t-esc="props.params.expectedLocationName || props.params.cycleCount?.location_name || ''"
                        />
                    </span>
                </div>
            </header>

            <main
                class="ilx-emp-v2-main ilx-count-main"
                t-ref="countMain"
            >
                <section class="ilx-count-scan-card" aria-labelledby="ilx-count-scan-title">
                    <div class="ilx-count-scan-card__heading">
                        <span class="ilx-count-scan-card__icon" aria-hidden="true">
                            <i class="fa fa-barcode" />
                        </span>
                        <div>
                            <h2 id="ilx-count-scan-title">Add a product</h2>
                            <p>Scan a barcode or enter a product, lot, or serial.</p>
                        </div>
                    </div>
                    <form
                        class="ilx-count-scan-form"
                        t-on-submit.prevent="resolveIdentityInput"
                    >
                        <label class="visually-hidden" for="cycle-count-identity">
                            Scan or enter a product barcode, lot, or serial
                        </label>
                        <div class="ilx-count-scan-input">
                            <i class="fa fa-search" aria-hidden="true" />
                            <input
                                id="cycle-count-identity"
                                t-ref="identityInput"
                                type="text"
                                name="product_identity"
                                aria-label="Scan or enter a product barcode, lot, or serial"
                                placeholder="Scan or enter barcode..."
                                autocomplete="off"
                                t-model="state.identityInput"
                                t-att-disabled="state.loading || state.error || state.applying || state.saving || state.resolvingScan"
                            />
                        </div>
                        <button
                            type="submit"
                            class="btn btn-primary ilx-count-add-btn"
                            t-att-disabled="state.loading || state.error || state.applying || state.saving || state.resolvingScan || !state.identityInput.trim()"
                        ><i class="fa fa-plus" aria-hidden="true" /> Add</button>
                    </form>
                </section>

                <section
                    t-if="!state.loading and !state.error and state.lines.length"
                    class="ilx-count-progress"
                    aria-label="Cycle count progress"
                >
                    <div class="ilx-count-progress__heading">
                        <span class="ilx-count-progress__label">
                            <strong t-esc="countedLines.length" /> of
                            <t t-esc="state.lines.length" /> counted
                        </span>
                        <span class="ilx-count-progress__percent">
                            <t t-esc="progressPercent" />%
                        </span>
                    </div>
                    <div
                        class="ilx-count-progress__bar"
                        role="progressbar"
                        aria-label="Counted lines"
                        t-att-aria-valuenow="countedLines.length"
                        aria-valuemin="0"
                        t-att-aria-valuemax="state.lines.length"
                        t-att-aria-valuetext="countedLines.length + ' of ' + state.lines.length + ' counted'"
                    ><div
                            class="ilx-count-progress__fill"
                            t-att-style="'width:' + progressPercent + '%'"
                        /></div>
                </section>

                <div
                    t-if="state.scanFeedback"
                    class="ilx-count-feedback"
                    t-att-class="'ilx-count-feedback--' + state.scanFeedback.type"
                    role="status"
                    aria-live="polite"
                ><i
                        t-att-class="state.scanFeedback.type === 'success' ? 'fa fa-check-circle' : state.scanFeedback.type === 'warning' ? 'fa fa-exclamation-triangle' : 'fa fa-times-circle'"
                        aria-hidden="true"
                    /> <t t-esc="state.scanFeedback.message" /></div>

                <div class="ilx-emp-v2-list ilx-count-list">
                    <div
                        t-if="state.loading"
                        class="ilx-count-state ilx-count-state--loading"
                        role="status"
                    ><i class="fa fa-spinner fa-spin" aria-hidden="true" /> Loading count lines...</div>
                    <div
                        t-elif="state.error"
                        class="ilx-count-state ilx-count-state--error"
                        role="alert"
                    ><i class="fa fa-exclamation-circle" aria-hidden="true" /> Unable to load count lines.</div>
                    <t t-else="">
                        <article
                            t-foreach="state.lines"
                            t-as="line"
                            t-key="line.quant_id"
                            class="ilx-emp-v2-card ilx-count-line"
                            t-att-data-quant-id="line.quant_id"
                            t-att-class="lineClasses(line)"
                        >
                            <div class="ilx-count-line__header">
                                <div class="ilx-count-line__identity">
                                    <h3 class="ilx-count-line__name" t-esc="line.product_name" />
                                    <span
                                        t-if="line.lot_name"
                                        class="ilx-count-line__lot"
                                        t-esc="line.lot_name"
                                    />
                                    <span
                                        t-if="line.tracking and line.tracking !== 'none'"
                                        class="ilx-count-tracking"
                                    ><i class="fa fa-tag" aria-hidden="true" /> <t t-esc="line.tracking" /></span>
                                </div>
                                <div class="ilx-count-difference">
                                    <span class="ilx-count-difference__label">Diff</span>
                                    <span
                                        class="ilx-count-diff-chip"
                                        t-att-class="differenceClass(line)"
                                        t-att-aria-label="difference(line) === null ? 'Not counted' : 'Difference ' + difference(line) + (line.uom ? ' ' + line.uom : '')"
                                    ><t t-if="difference(line) !== null">
                                            <t t-if="difference(line) > 0">+</t>
                                            <t t-esc="difference(line)" />
                                            <small t-if="line.uom" t-esc="line.uom" />
                                        </t><t t-else="">—</t></span>
                                </div>
                            </div>

                            <div class="ilx-count-qty">
                                <div class="ilx-count-qty__field ilx-count-on-hand">
                                    <span class="ilx-count-qty__label">On hand</span>
                                    <strong class="ilx-count-qty__value">
                                        <t t-esc="line.theoretical_qty" />
                                        <small t-if="line.uom" t-esc="line.uom" />
                                    </strong>
                                </div>
                                <div class="ilx-count-qty__field ilx-counted-control">
                                    <label
                                        class="ilx-count-qty__label"
                                        t-att-for="'counted-qty-' + line.quant_id"
                                    >Counted</label>
                                    <div class="ilx-count-stepper" role="group">
                                        <button
                                            type="button"
                                            class="ilx-count-stepper__button"
                                            t-att-aria-label="'Decrease counted quantity for ' + line.product_name"
                                            t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan || line.counted === null || line.counted &lt;= 0"
                                            t-on-click="() => this.adjustCounted(line, -this.quantityStep(line))"
                                        ><i class="fa fa-minus" aria-hidden="true" /></button>
                                        <input
                                            t-att-id="'counted-qty-' + line.quant_id"
                                            type="number"
                                            min="0"
                                            t-att-step="quantityStep(line)"
                                            t-att-placeholder="'Enter qty'"
                                            t-att-aria-label="'Counted quantity for ' + line.product_name + (line.lot_name ? ' ' + line.lot_name : '')"
                                            t-att-value="line.counted"
                                            t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan"
                                            t-on-input="(ev) => this.setCounted(line, ev.target.value)"
                                        />
                                        <button
                                            type="button"
                                            class="ilx-count-stepper__button"
                                            t-att-aria-label="'Increase counted quantity for ' + line.product_name"
                                            t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan || (line.tracking === 'serial' and line.counted &gt;= 1)"
                                            t-on-click="() => this.adjustCounted(line, quantityStep(line))"
                                        ><i class="fa fa-plus" aria-hidden="true" /></button>
                                    </div>
                                </div>
                            </div>

                            <div class="ilx-count-quick">
                                <span class="ilx-count-quick__label">Quick count</span>
                                <div class="ilx-count-quick__actions">
                                    <button
                                        type="button"
                                        class="ilx-count-quick__button ilx-count-quick__button--match"
                                        t-if="line.counted !== line.theoretical_qty"
                                        t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan"
                                        t-on-click="() => this.setCountToOnHand(line)"
                                    ><i class="fa fa-bullseye" aria-hidden="true" /> Set to <t t-esc="line.theoretical_qty" /></button>
                                    <button
                                        type="button"
                                        class="ilx-count-quick__button"
                                        t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan || (line.tracking === 'serial' and line.counted &gt;= 1)"
                                        t-on-click="() => this.adjustCounted(line, 1)"
                                    >+1</button>
                                    <button
                                        t-if="line.tracking !== 'serial'"
                                        type="button"
                                        class="ilx-count-quick__button"
                                        t-att-disabled="state.loading || state.applying || state.saving || state.resolvingScan"
                                        t-on-click="() => this.adjustCounted(line, 5)"
                                    >+5</button>
                                </div>
                            </div>
                        </article>
                        <div
                            t-if="!state.lines.length"
                            class="ilx-count-state ilx-count-state--empty"
                        ><i class="fa fa-inbox" aria-hidden="true" /> No stock in this location.</div>
                    </t>
                </div>
            </main>

            <footer class="ilx-emp-v2-footer ilx-count-footer">
                <button
                    type="button"
                    class="btn btn-outline-secondary ilx-count-save"
                    t-on-click="saveCount"
                    t-att-disabled="state.loading || state.error || state.applying || state.saving || state.resolvingScan || !hasDirtyLines"
                    t-att-aria-busy="state.saving"
                >
                    <i
                        t-if="state.saving"
                        class="fa fa-spinner fa-spin"
                        aria-hidden="true"
                    /><i
                        t-else=""
                        class="fa fa-floppy-o"
                        aria-hidden="true"
                    /><span t-if="state.saving">Saving...</span><span t-else="">Save Draft</span>
                </button>
                <button
                    type="button"
                    class="ilx-emp-v2-confirm-btn ilx-count-apply"
                    t-on-click="apply"
                    t-att-disabled="state.loading || state.error || state.applying || state.saving || state.resolvingScan"
                >
                    <span class="ilx-count-apply__label"><i class="fa fa-check" aria-hidden="true" /> Apply count</span>
                    <span
                        t-if="state.lines.length"
                        class="ilx-count-apply__progress"
                    ><t t-esc="countedLines.length" /> verified</span>
                    <i
                        t-else=""
                        class="fa fa-arrow-right"
                        aria-hidden="true"
                    />
                </button>
            </footer>
        </div>
    </t>
    <t t-name="barcode_stock_cycle_count.CycleCountDoneScreen">
        <div class="ilx-emp-v2-screen ilx-cycle-count-done">
            <header class="ilx-emp-v2-header ilx-cycle-count-done__header">
                <button
                    type="button"
                    class="ilx-emp-v2-back-btn ilx-cycle-count-done__back"
                    aria-label="Return to cycle counts"
                    t-on-click="backToList"
                ><i class="fa fa-arrow-left" aria-hidden="true" /></button>
                <div class="ilx-cycle-count-done__header-copy">
                    <h1 class="ilx-emp-v2-header-title">Cycle Count</h1>
                    <span
                        t-if="props.params.cycleCount?.name"
                        class="ilx-cycle-count-done__count-name"
                        t-esc="props.params.cycleCount.name"
                    />
                </div>
                <span class="ilx-cycle-count-done__status">
                    <i class="fa fa-check-circle" aria-hidden="true" /> Complete
                </span>
            </header>

            <main class="ilx-emp-v2-main ilx-cycle-count-done__main">
                <section
                    class="ilx-cycle-count-done__summary"
                    aria-labelledby="cycle-count-done-title"
                    role="status"
                >
                    <span class="ilx-cycle-count-done__mark" aria-hidden="true">
                        <i class="fa fa-check" />
                    </span>
                    <p class="ilx-cycle-count-done__eyebrow">Inventory review</p>
                    <h2 id="cycle-count-done-title">Cycle count complete</h2>
                    <p
                        t-if="props.params.cycleCount?.location_name"
                        class="ilx-cycle-count-done__location"
                    >
                        <i class="fa fa-map-marker" aria-hidden="true" />
                        <t t-esc="props.params.cycleCount.location_name" />
                    </p>
                </section>

                <section
                    class="ilx-cycle-count-done__results"
                    aria-label="Cycle count results"
                >
                    <article class="ilx-cycle-count-done__result">
                        <span class="ilx-cycle-count-done__result-label">Applied lines</span>
                        <strong t-esc="props.params.appliedCount ?? 0" />
                    </article>
                    <article class="ilx-cycle-count-done__result">
                        <span class="ilx-cycle-count-done__result-label">Accuracy</span>
                        <strong><t t-esc="props.params.accuracy ?? 0" />%</strong>
                    </article>
                </section>
            </main>

            <footer class="ilx-emp-v2-footer ilx-cycle-count-done__footer">
                <button
                    type="button"
                    class="ilx-emp-v2-confirm-btn ilx-cycle-count-done__return"
                    t-on-click="backToList"
                ><i class="fa fa-list" aria-hidden="true" /> Return to cycle counts</button>
            </footer>
        </div>
    </t>
</templates>
