<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_barcode_scanner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.barcode.scanner</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    name="barcode_scanner"
                    string="Barcode Scanner"
                    groups="stock.group_stock_manager"
                >
                    <block title="Barcode Reader">
                        <setting
                            id="barcode_hex_input"
                            title="Hex Input Mode"
                            help="Enable for using hexadecimal readings."
                        >
                            <field name="barcode_hex_input" />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
